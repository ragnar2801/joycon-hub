# All settings are public static build configuration. Never put secrets here.
# Optional public HTTPS frontend URL for QR codes during tunnel-based development.
VITE_CONTROLLER_URL=
# GitHub project Pages base. CI sets this automatically from the repository name.
VITE_BASE_PATH=/

# Optional self-hosted PeerServer for signaling. Leave blank for PeerJS Cloud.
VITE_SIGNAL_HOST=
VITE_SIGNAL_PORT=443
VITE_SIGNAL_PATH=/
