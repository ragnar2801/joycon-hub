# Public frontend settings (included in the static build; never put secrets here).
# Local development defaults to http://localhost:3001.
VITE_SERVER_URL=
# Optional public HTTPS frontend URL for QR codes during tunnel-based development.
VITE_CONTROLLER_URL=
# GitHub project Pages base. CI sets this automatically from the repository name.
VITE_BASE_PATH=/

# Backend settings. Production MUST include the exact GitHub Pages origin.
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
